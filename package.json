{
  "name": "pocket-tactics",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "sim": "tsx scripts/sim.ts",
    "dashboard": "tsx scripts/dashboard.ts",
    "telemetry": "tsx scripts/sim.ts 10000 --tag=baseline && tsx scripts/dashboard.ts baseline",
    "a11y": "node scripts/a11y-audit.mjs",
    "puzzles": "tsx scripts/verify-puzzles.ts",
    "campaign": "tsx scripts/campaign-test.ts",
    "check": "npm run build && npx tsx scripts/smoke.ts && npx tsx scripts/verify-puzzles.ts && npx tsx scripts/campaign-test.ts",
    "tutorial": "node scripts/tutorial-test.mjs",
    "verify": "npm run check && node scripts/a11y-audit.mjs && node scripts/tutorial-test.mjs && node scripts/puzzle-ui-test.mjs && node scripts/campaign-ui-test.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "trystero": "^0.25.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.0"
  }
}